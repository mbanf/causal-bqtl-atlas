        "maize_tf_pwm_database.json -- 259 PWMs"
      ]
    },
    {
      "dot": "emerald",
      "title": "Key Outputs",
      "items": [
        "causal_bqtl_728.csv + regulatory_map_728.csv",
        "gene_atlas_728.csv -- deep characterization",
        "ww_vs_drought + condition_switching CSVs",
        "28 PDF figures; config via params.yaml"
      ]
    }
  ]
