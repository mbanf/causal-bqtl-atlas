/*
 * Causal bQTL Atlas Pipeline — Nextflow Configuration
 *
 * Profiles:
 *   local (default) — run on your machine
 *   slurm           — submit to SLURM cluster
 *   pbs             — submit to PBS/Torque cluster
 *   sge             — submit to SGE/UGE cluster
 *   conda           — auto-create conda environment
 *   docker          — run in Docker container
 *   singularity     — run in Singularity container (HPC-friendly)
 *
 * Usage:
 *   nextflow run main.nf                           # local
 *   nextflow run main.nf -profile slurm,conda      # HPC + conda
 *   nextflow run main.nf -profile slurm,singularity # HPC + container
 */

// ── Parameters ──
params {
    // Input data
    data_dir       = "${projectDir}/data"
    genotype_dir   = null  // path to Julia's NAM_genotypes_2FP_WW folder (optional)

    // Output
    results_dir    = "${projectDir}/results"
    figures_dir    = "${projectDir}/figures"

    // Pipeline options
    skip_genotype_download = true   // use pre-converted genotypes
    paper_only             = false  // skip exploratory scripts

    // Organism-specific (override for non-maize)
    genome_fasta   = "${params.data_dir}/raw/B73_NAM5.fa"
    gff3           = "${params.data_dir}/raw/Zm-B73-REFERENCE-NAM-5.0_Zm00001eb.1.gff3"
    pwm_database   = "${params.data_dir}/processed/maize_tf_pwm_database.json"
    promoter_size  = 2000  // bp upstream of TSS
    fdr_threshold  = 0.05
    motif_score_threshold = 6.0
}

// ── Process defaults ──
process {
    // Default resources
    cpus   = 2
    memory = '8 GB'
    time   = '2h'

    // Error strategy: retry once then fail
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
    maxRetries    = 1

    // Resource scaling for specific processes
    withName: 'BOUND_REGION_MOTIFS' {
        memory = '16 GB'
        time   = '4h'
    }
    withName: 'GENOTYPE_BQTL_TEST' {
        memory = '16 GB'
        time   = '2h'
    }
    withName: 'WW_VS_DROUGHT' {
        memory = '16 GB'
        time   = '3h'
    }
    withName: 'CONVERT_GENOTYPES' {
        memory = '8 GB'
        time   = '1h'
    }
}

// ── Execution profiles ──
profiles {

    // Local execution (default)
    standard {
        process.executor = 'local'
    }

    // SLURM (most common HPC scheduler)
    slurm {
        process {
            executor = 'slurm'
            queue    = 'normal'
            // Uncomment and adjust for your cluster:
            // clusterOptions = '--account=your_account'
        }
    }

    // PBS/Torque
    pbs {
        process {
            executor = 'pbs'
            queue    = 'default'
        }
    }

    // SGE/UGE (Sun Grid Engine)
    sge {
        process {
            executor = 'sge'
        }
    }

    // Conda environment (auto-created from environment.yml)
    conda {
        conda.enabled  = true
        process.conda  = "${projectDir}/environment.yml"
    }

    // Docker container
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.container = 'mbanf/causal-bqtl-atlas:latest'
    }

    // Singularity (preferred on HPC — no root required)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container      = 'docker://mbanf/causal-bqtl-atlas:latest'
    }

    // AWS Batch
    aws {
        process {
            executor = 'awsbatch'
            queue    = 'causal-bqtl-queue'
        }
        aws.batch.cliPath = '/usr/local/bin/aws'
    }

    // Test profile (quick validation with subset)
    test {
        params.data_dir    = "${projectDir}/test/data"
        params.results_dir = "${projectDir}/test/results"
    }
}

// ── Reports ──
timeline {
    enabled   = true
    file      = "${params.results_dir}/logs/pipeline_timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.results_dir}/logs/pipeline_report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.results_dir}/logs/pipeline_trace.tsv"
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,peak_rss,%cpu,rchar,wchar'
}

dag {
    enabled   = true
    file      = "${params.results_dir}/logs/pipeline_dag.html"
    overwrite = true
}

// ── Manifest ──
manifest {
    name            = 'mbanf/causal-bqtl-atlas'
    author          = 'Michael Banf, Thomas Hartwig'
    description     = 'Pipeline for identifying high-confidence causal bQTL from plant pan-cistrome data'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04'
    version         = '1.0.0'
    homePage        = 'https://github.com/mbanf/causal-bqtl-atlas'
}
