/*
 * Nextflow config for Causal bQTL Atlas Pipeline
 */

// Default parameters
params {
    data_dir    = "${projectDir}/data"
    results_dir = "${projectDir}/results"
    scripts_dir = "${projectDir}/scripts"
    skip_genotype_download = true
    paper_only  = false
}

// Execution profiles
profiles {

    // Local execution (default)
    standard {
        process {
            executor = 'local'
            cpus = 4
            memory = '16 GB'
        }
    }

    // Conda environment
    conda {
        process.conda = "${projectDir}/environment.yml"
    }

    // Docker container
    docker {
        docker.enabled = true
        process.container = 'mbanf/causal-bqtl-atlas:latest'
    }

    // Singularity (HPC)
    singularity {
        singularity.enabled = true
        process.container = 'docker://mbanf/causal-bqtl-atlas:latest'
    }

    // Test profile with minimal data
    test {
        params.data_dir = "${projectDir}/test/data"
        params.results_dir = "${projectDir}/test/results"
    }
}

// Timeline and report
timeline {
    enabled = true
    file    = "${params.results_dir}/pipeline_timeline.html"
}

report {
    enabled = true
    file    = "${params.results_dir}/pipeline_report.html"
}

trace {
    enabled = true
    file    = "${params.results_dir}/pipeline_trace.txt"
}

// Manifest
manifest {
    name            = 'mbanf/causal-bqtl-atlas'
    author          = 'Michael Banf, Thomas Hartwig'
    description     = 'Pipeline for identifying high-confidence causal bQTL from maize pan-cistrome data'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04'
    version         = '1.0.0'
}
